                                    HStack {
                                        Text("Cost:")
                                            .font(.caption2)
                                            .foregroundColor(.textSecondary)
                                        TextField("0.00", value: $parsedItems[idx].unitCost, formatter: NumberFormatter.currencyFormatter)
                                            .font(.system(.footnote, design: .rounded)).fontWeight(.bold)
