                                VStack(alignment: .leading, spacing: 4) {
                                    // Found Item Text
                                    TextField("Scanned item name", text: $parsedItems[idx].name)
                                        .font(.subheadline).fontWeight(.bold)
                                        .foregroundColor(.textPrimary)
                                        .textFieldStyle(.plain)

                                    HStack(spacing: 8) {
