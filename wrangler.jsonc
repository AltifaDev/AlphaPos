{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphapos",
  "compatibility_date": "2026-06-16",
  "main": "customer-order-web/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "customer-order-web/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SUPABASE_URL": "https://api.alphaposweb.com",
    "LOCAL_SERVER_URL": "https://sync.alphaposweb.com"
  }
}
