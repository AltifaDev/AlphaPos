# AlphaPos Customer Order Web - Server Configuration
# Copy this file to .env and fill in your values.
# .env is in .gitignore and should NEVER be committed.

PORT=8080

# Supabase Configuration
# Simulator/browser on this Mac: http://127.0.0.1:54321
# Physical devices: use the Mac's LAN IP, e.g. http://192.168.1.20:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
MERCHANT_ID=

# API Authentication (required outside localhost; use a random secret in production)
API_AUTH_TOKEN=

# Pricing and payment
SERVICE_CHARGE_RATE=0.10
VAT_RATE=0.07
PROMPTPAY_ID=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Environment: set to "production" to disable dev features
ALPHAPOS_ENV=development
