# AlphaPos Customer Order Web - Server Configuration
# Copy this file to .env and fill in your values.
# .env is in .gitignore and should NEVER be committed.

PORT=8080

# Supabase Configuration
# Simulator/browser on this Mac: http://127.0.0.1:54321
# Physical devices: use the Mac's LAN IP, e.g. http://192.168.1.20:54321
SUPABASE_URL=http://127.0.0.1:54321
# Browser-facing HTTPS API (CSP connect-src + client config). Required when
# SUPABASE_URL is loopback, a private IP, or plain HTTP (e.g. VPS IP).
PUBLIC_SUPABASE_URL=https://api.alphaposweb.com
# Browser Realtime WSS uses this public HTTPS host (Worker injects supabaseRealtimeUrl).
# SUPABASE_REALTIME_URL=https://api.alphaposweb.com
SUPABASE_ANON_KEY=
MERCHANT_ID=

# API Authentication (required outside localhost; use a random secret in production)
API_AUTH_TOKEN=

# Pricing and payment
SERVICE_CHARGE_RATE=0.10
VAT_RATE=0.07
PROMPTPAY_ID=

# Web Push (VAPID) — for browser order-status notifications.
# Generate a key pair once with:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); v.save_key('private.pem')"
# or use the pair generated during setup. Public key is safe to expose; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alphapos.local

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Environment: set to "production" to disable dev features
ALPHAPOS_ENV=development
